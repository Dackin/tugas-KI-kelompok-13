# Salin file ini menjadi .env, lalu isi nilainya:
#     cp .env.example .env
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# Setiap anggota memakai .env sendiri; nilainya boleh berbeda.

# Kunci sesi Flask. Wajib diganti; string acak panjang.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-token-acak

# Kunci induk kriptografi dokumen (64 karakter hex = 32 byte).
# Dipakai app/crypto/keys.py untuk menurunkan kunci AES/DES/RC4.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_MASTER_KEY=ganti-dengan-64-karakter-hex

# Lokasi database. Biarkan dikomentari untuk memakai default
# (SQLite di instance/secure_rt_dev.sqlite3).
# JANGAN diisi kosong (DATABASE_URL=) — nilai kosong akan menimpa default.
# DATABASE_URL=sqlite:///secure_rt_dev.sqlite3

# Folder penyimpanan ciphertext, relatif terhadap root project.
PRIVATE_STORAGE_DIR=private_storage

# Batas ukuran upload dalam MB.
MAX_CONTENT_LENGTH_MB=50
