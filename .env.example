# Salin file ini menjadi .env untuk pengembangan lokal.
#     cp .env.example .env
# Jangan pernah memasukkan nilai secret sebenarnya ke Git.
# Setiap anggota memakai .env sendiri; nilainya boleh berbeda.

# Kunci sesi Flask. Wajib diisi; string acak.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Master key kriptografi dokumen: Base64 dari tepat 32 byte acak.
# Dibaca oleh app/crypto/keys.py sebagai CRYPTO_MASTER_KEY_B64.
# Buat dengan: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CRYPTO_MASTER_KEY_B64=

# Lokasi database. Biarkan dikomentari untuk memakai default
# (SQLite di instance/secure_rt_dev.sqlite3).
# JANGAN diisi kosong (DATABASE_URL=) — nilai kosong menimpa default.
# DATABASE_URL=sqlite:///secure_rt_dev.sqlite3

# Folder penyimpanan ciphertext, relatif terhadap root project.
PRIVATE_STORAGE_DIR=private_storage

# Batas ukuran upload dalam MB.
MAX_CONTENT_LENGTH_MB=50

# Kode undangan untuk mendaftar sebagai admin lewat /auth/register.
# Kosongkan untuk menonaktifkan; akun admin lalu dibuat lewat seed/manual.
ADMIN_INVITE_CODE=

# Setel true hanya saat produksi di belakang HTTPS, agar cookie session
# tidak dikirim lewat koneksi biasa.
SESSION_COOKIE_SECURE=false
